#!/usr/bin/env bash
# Thin wrapper — Cline requires hooks to be actual executable files at this
# exact name/location. Real logic is vendored and read-only; see
# external/ai-session-kit/scripts/check-handoff-cline.sh.
#
# Registered alongside TaskComplete and TaskCancel: which one fires depends on
# the surface and how the session ended (confirmed empirically) — this one
# reliably fired when a headless CLI run was killed with SIGINT (TaskCancel
# did not), but did NOT fire when the user clicked Cancel in the VS Code
# extension's panel (TaskCancel covers that case instead). A near-identical
# copy also lives at .cline/hooks/SessionShutdown.sh (with extension) for the
# Cline CLI, which doesn't discover hooks from this directory.
exec "$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)/external/ai-session-kit/scripts/check-handoff-cline.sh" SessionShutdown
